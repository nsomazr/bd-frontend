# Leave VITE_API_BASE_URL EMPTY to use same-origin requests through the Vite
# dev proxy (recommended). Set it only when the SPA must talk to a different
# origin (e.g. cross-origin staging).
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api/* requests in development.
# Defaults to http://127.0.0.1:8090.
# VITE_API_PROXY_TARGET=http://127.0.0.1:8090
